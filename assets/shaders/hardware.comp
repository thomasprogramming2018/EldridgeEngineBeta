#version 460
#extension GL_EXT_ray_query : require
layout(local_size_x=8,local_size_y=8) in;
layout(set=0,binding=0) uniform accelerationStructureEXT scene;
struct Pixel { vec4 sum, normalDepth, albedoRoughness, moments; };
layout(std430,set=0,binding=1) buffer Image { Pixel pixels[]; };
struct Triangle { vec4 a,b,c,na,nb,nc,uvAB,uvCMaterial; };
layout(std430,set=0,binding=2) readonly buffer Geometry { Triangle triangles[]; };
struct Material { vec4 colorRoughness,emissionMetallic,settings; };
layout(std430,set=0,binding=3) readonly buffer Materials { Material materials[]; };
layout(std140,set=0,binding=4) uniform Camera { mat4 inverseVP; vec4 eye,sun,options,render,filterSettings,visualSun; } camera;
layout(set=0,binding=5) uniform sampler2DArray colorMaps;
layout(set=0,binding=6) uniform sampler2DArray normalMaps;
layout(set=0,binding=7) uniform sampler2DArray metalRoughMaps;
struct Light { vec4 positionType, directionRange, colorIntensity, rightWidth, upHeight, shape, parameters; };
layout(std430,set=0,binding=8) readonly buffer Lights { Light lights[]; };
layout(push_constant) uniform Parameters { uint width,height,start,samples,bounces,triangleCount,pad0,pad1; } parameters;
const float PI=3.14159265359;
uint state;
float randomFloat()
{
    state=state*747796405u+2891336453u;
    uint word=((state>>((state>>28u)+4u))^state)*277803737u;
    return float((word>>22u)^word)/4294967296.0;
}
vec3 sky(vec3 direction, bool primary)
{
    float t=clamp(direction.y*0.5+0.5,0.0,1.0);
    vec3 color=mix(vec3(0.09,0.11,0.15),vec3(0.32,0.5,0.9),t)*camera.render.x;
    // Direct sun lighting is sampled explicitly. A second sun on bounce rays
    // would count its energy twice and create rare bright fireflies.
    if (primary && camera.visualSun.w > 0.0)
        color += camera.visualSun.rgb * smoothstep(cos(camera.visualSun.w), cos(camera.visualSun.w*0.8), dot(direction,camera.sun.xyz));
    return color;
}
bool query(vec3 origin,vec3 direction,float maximum,out int index,out vec2 bary,out float distance)
{
    if(parameters.triangleCount==0) return false;
    rayQueryEXT ray;
    rayQueryInitializeEXT(ray,scene,gl_RayFlagsOpaqueEXT,0xff,origin,0.002,direction,maximum);
    while(rayQueryProceedEXT(ray)) {}
    if(rayQueryGetIntersectionTypeEXT(ray,true)==gl_RayQueryCommittedIntersectionNoneEXT) return false;
    index=int(rayQueryGetIntersectionPrimitiveIndexEXT(ray,true));
    bary=rayQueryGetIntersectionBarycentricsEXT(ray,true);
    distance=rayQueryGetIntersectionTEXT(ray,true);
    return true;
}
bool occluded(vec3 origin,vec3 direction,float maximum)
{
    if(parameters.triangleCount==0) return false;
    rayQueryEXT ray;
    rayQueryInitializeEXT(ray,scene,gl_RayFlagsOpaqueEXT|gl_RayFlagsTerminateOnFirstHitEXT,0xff,origin,0.003,direction,max(maximum,0.0031));
    while(rayQueryProceedEXT(ray)) {}
    return rayQueryGetIntersectionTypeEXT(ray,true)!=gl_RayQueryCommittedIntersectionNoneEXT;
}
mat3 basis(vec3 normal)
{
    vec3 tangent=normalize(abs(normal.z)<0.99?cross(vec3(0,0,1),normal):cross(vec3(0,1,0),normal));
    return mat3(tangent,cross(normal,tangent),normal);
}
vec3 fresnel(float cosine,vec3 f0) { return f0+(1.0-f0)*pow(clamp(1.0-cosine,0.0,1.0),5.0); }
vec3 brdf(vec3 N,vec3 V,vec3 L,vec3 base,float metallic,float roughness)
{
    vec3 H=normalize(V+L); float nv=max(dot(N,V),0.001),nl=max(dot(N,L),0.001),nh=max(dot(N,H),0.0);
    float a=roughness*roughness,a2=a*a,d=nh*nh*(a2-1.0)+1.0;
    float D=a2/max(PI*d*d,0.000001);
    float k=(roughness+1.0)*(roughness+1.0)/8.0;
    float G=nv/(nv*(1.0-k)+k)*nl/(nl*(1.0-k)+k);
    vec3 F=fresnel(max(dot(V,H),0.0),mix(vec3(0.04),base,metallic));
    return (1.0-F)*(1.0-metallic)*base/PI+D*G*F/max(4.0*nv*nl,0.001);
}
struct HitSurface
{
    vec3 point, normal, geometric, base;
    float roughness, metallic, distance;
    int materialIndex, triangleIndex;
};
bool surfaceAt(vec3 origin, vec3 direction, out HitSurface hit)
{
    int index; vec2 bary; float distance;
    if (!query(origin, direction, 100000.0, index, bary, distance)) return false;
    Triangle triangle=triangles[index];
    int materialIndex=int(triangle.uvCMaterial.z+0.5); Material material=materials[materialIndex];
    vec3 weights=vec3(1.0-bary.x-bary.y,bary.x,bary.y);
    vec3 N=normalize(triangle.na.xyz*weights.x+triangle.nb.xyz*weights.y+triangle.nc.xyz*weights.z);
    vec3 geometric=normalize(cross(triangle.b.xyz-triangle.a.xyz,triangle.c.xyz-triangle.a.xyz));
    if(dot(geometric,direction)>0) geometric=-geometric;
    if(dot(N,geometric)<0) N=-N;
    vec3 point=origin+direction*distance;
    vec2 uv=triangle.uvAB.xy*weights.x+triangle.uvAB.zw*weights.y+triangle.uvCMaterial.xy*weights.z;
    vec3 base=material.colorRoughness.rgb*pow(textureLod(colorMaps,vec3(uv,materialIndex),0).rgb,vec3(2.2));
    if(material.settings.w>0.5)
    {
        vec2 d1=triangle.uvAB.zw-triangle.uvAB.xy,d2=triangle.uvCMaterial.xy-triangle.uvAB.xy;
        vec3 e1=triangle.b.xyz-triangle.a.xyz,e2=triangle.c.xyz-triangle.a.xyz;
        float determinant=d1.x*d2.y-d1.y*d2.x;
        if(abs(determinant)>0.000001)
        {
        vec3 tangent=normalize((e1*d2.y-e2*d1.y)/determinant);
        tangent=normalize(tangent-N*dot(N,tangent));
        vec3 mapped=textureLod(normalMaps,vec3(uv,materialIndex),0).xyz*2.0-1.0;
        mapped.xy*=material.settings.y; mapped.y=-mapped.y;
        N=normalize(mat3(tangent,cross(N,tangent),N)*mapped);
        if(dot(N,geometric)<0) N=-N;
        }
    }
    vec2 maps=textureLod(metalRoughMaps,vec3(uv,materialIndex),0).rg;
    float roughness=clamp(material.colorRoughness.a*maps.g,0.04,1.0);
    float metallic=clamp(material.emissionMetallic.a*maps.r,0.0,1.0);
    hit.point = point; hit.normal = N; hit.geometric = geometric;
    hit.base = base; hit.roughness = roughness; hit.metallic = metallic;
    hit.distance = distance; hit.materialIndex = materialIndex; hit.triangleIndex = index;
    return true;
}
// Sample GGX normals visible from V, avoiding many below-surface samples.
vec3 sampleVisibleGGX(vec3 N, vec3 V, float roughness)
{
    mat3 frame=basis(N); vec3 local=transpose(frame)*V;
    float a=roughness*roughness;
    vec3 stretched=normalize(vec3(a*local.xy,max(local.z,0.001)));
    float lengthXY=dot(stretched.xy,stretched.xy);
    vec3 T=lengthXY>0.0?vec3(-stretched.y,stretched.x,0)/sqrt(lengthXY):vec3(1,0,0);
    vec3 B=cross(stretched,T);
    float r=sqrt(randomFloat()),phi=2.0*PI*randomFloat();
    float x=r*cos(phi),y=r*sin(phi),blend=0.5*(1.0+stretched.z);
    y=(1.0-blend)*sqrt(max(0.0,1.0-x*x))+blend*y;
    vec3 halfNormal=T*x+B*y+stretched*sqrt(max(0.0,1.0-x*x-y*y));
    return normalize(frame*normalize(vec3(a*halfNormal.xy,max(0.0,halfNormal.z))));
}
vec3 surfaceBrdf(HitSurface hit,vec3 V,vec3 L)
{
    float coat=clamp(materials[hit.materialIndex].settings.z,0.0,1.0);
    vec3 base=brdf(hit.normal,V,L,hit.base,hit.metallic,hit.roughness);
    vec3 coating=brdf(hit.normal,V,L,vec3(0),0.0,.15);
    return base*(1.0-.04*coat)+coating*coat;
}
float bsdfPdf(vec3 N,vec3 V,vec3 L,float metallic,float roughness)
{
    float nv=max(dot(N,V),0.001),nl=max(dot(N,L),0.0);
    if(nl<=0.0) return 0.0;
    vec3 H=normalize(V+L); float nh=max(dot(N,H),0.0);
    float a=roughness*roughness,a2=a*a,d=nh*nh*(a2-1.0)+1.0;
    float D=a2/max(PI*d*d,0.000001);
    float G1=2.0*nv/(nv+sqrt(a2+(1.0-a2)*nv*nv));
    float probability=camera.render.y>0.5?mix(0.25,0.9,metallic):1.0;
    return mix(nl/PI,D*G1/(4.0*nv),probability);
}
float powerWeight(float a,float b) { return a*a/max(a*a+b*b,0.00000001); }
vec3 coneDirection(vec3 axis,float angle)
{
    float cosine=mix(1.0,cos(angle),randomFloat());
    float sine=sqrt(max(0.0,1.0-cosine*cosine)),phi=2.0*PI*randomFloat();
    return normalize(basis(axis)*vec3(sine*cos(phi),sine*sin(phi),cosine));
}
vec3 directLight(HitSurface hit,vec3 V,Light light)
{
    int type=int(light.positionType.w+0.5);
    vec3 L; float maximum=100000.0,attenuation=1.0;
    if(type==0) L=coneDirection(-light.directionRange.xyz,light.shape.y);
    else
    {
        vec3 target=light.positionType.xyz;
        if(type==3)
            target+=light.rightWidth.xyz*((randomFloat()-0.5)*light.rightWidth.w)+light.upHeight.xyz*((randomFloat()-0.5)*light.upHeight.w);
        else if(light.shape.x>0.0)
        {
            vec3 toLight=target-hit.point;
            if(dot(toLight,toLight)<0.000001) return vec3(0);
            float r=sqrt(randomFloat())*light.shape.x,phi=2.0*PI*randomFloat();
            target+=basis(normalize(toLight))*vec3(r*cos(phi),r*sin(phi),0);
        }
        vec3 delta=target-hit.point; maximum=length(delta);
        if(maximum<0.005||maximum>light.directionRange.w) return vec3(0);
        L=delta/maximum;
        float falloff=clamp(1.0-pow(maximum/light.directionRange.w,4.0),0.0,1.0);
        attenuation=falloff*falloff/max(maximum*maximum,0.01);
        if(type==2)
        {
            float cone=dot(-L,light.directionRange.xyz);
            float t=clamp((cone-light.shape.w)/max(light.shape.z-light.shape.w,0.00001),0.0,1.0);
            attenuation*=t*t*(3.0-2.0*t);
        }
        if(type==3) attenuation*=light.rightWidth.w*light.upHeight.w*max(dot(-L,light.directionRange.xyz),0.0);
    }
    float nl=max(dot(hit.normal,L),0.0);
    if(nl<=0.0||attenuation<=0.0) return vec3(0);
    if(light.parameters.x>0.5 && occluded(hit.point+hit.geometric*0.005,L,maximum-0.006)) return vec3(0);
    return surfaceBrdf(hit,V,L)*nl*light.colorIntensity.rgb*light.colorIntensity.w*attenuation;
}
vec3 sampleEmission(HitSurface hit,vec3 V,bool lastBounce)
{
    int count=int(camera.options.w+0.5),offset=int(camera.options.z+0.5);
    if(count==0) return vec3(0);
    float choice=randomFloat(); int low=0,high=count-1;
    while(low<high) {int middle=(low+high)/2;if(lights[offset+middle].parameters.y<choice) low=middle+1;else high=middle;}
    Light emitter=lights[offset+low];
    Triangle tri=triangles[int(emitter.parameters.x+0.5)];
    float r=sqrt(randomFloat()),v=randomFloat();
    vec3 point=tri.a.xyz*(1.0-r)+tri.b.xyz*(r*(1.0-v))+tri.c.xyz*(r*v);
    vec3 delta=point-hit.point;float distance=length(delta);
    if(distance<0.01) return vec3(0);
    vec3 L=delta/distance;
    vec3 emitterNormal=normalize(cross(tri.b.xyz-tri.a.xyz,tri.c.xyz-tri.a.xyz));
    float cosine=abs(dot(emitterNormal,-L)),nl=max(dot(hit.normal,L),0.0);
    if(cosine<0.00001||nl<=0.0) return vec3(0);
    float pdf=emitter.parameters.z*distance*distance/max(emitter.parameters.w*cosine,0.000001);
    if(occluded(hit.point+hit.geometric*0.005,L,distance-0.008)) return vec3(0);
    float weight=lastBounce?1.0:powerWeight(pdf,bsdfPdf(hit.normal,V,L,hit.metallic,hit.roughness));
    return emitter.colorIntensity.rgb*surfaceBrdf(hit,V,L)*nl*weight/max(pdf,0.000001);
}
vec3 path(vec3 origin,vec3 direction,out vec4 firstSurface,uint bounceLimit)
{
    vec3 radiance=vec3(0),throughput=vec3(1);
    float previousPdf=0.0; firstSurface=vec4(0);
    for(uint bounce=0;bounce<bounceLimit;++bounce)
    {
        HitSurface hit;
        if(!surfaceAt(origin,direction,hit)) {radiance+=throughput*sky(direction,bounce==0);break;}
        Material material=materials[hit.materialIndex];
        vec3 N=hit.normal,V=-direction;
        if(bounce==0) firstSurface=vec4(N,hit.distance);
        vec3 contribution=vec3(0);
        float emissionWeight=1.0;
        float emitterProbability=triangles[hit.triangleIndex].uvCMaterial.w;
        if(bounce>0&&emitterProbability>0.0)
        {
            Triangle tri=triangles[hit.triangleIndex];
            vec3 crossEdges=cross(tri.b.xyz-tri.a.xyz,tri.c.xyz-tri.a.xyz);
            float area=length(crossEdges)*0.5,cosine=abs(dot(normalize(crossEdges),-direction));
            float lightPdf=emitterProbability*hit.distance*hit.distance/max(area*cosine,0.000001);
            emissionWeight=powerWeight(previousPdf,lightPdf);
        }
        contribution+=material.emissionMetallic.rgb*emissionWeight;
        if(material.settings.x<0.5) {radiance+=throughput*(contribution+hit.base);break;}
        if(camera.sun.w>0.0)
        {
            vec3 L=coneDirection(camera.sun.xyz,camera.render.w);
            float nl=max(dot(N,L),0.0);
            if(nl>0.0&&!occluded(hit.point+hit.geometric*0.005,L,100000.0))
                contribution+=surfaceBrdf(hit,V,L)*vec3(1.0,0.94,0.82)*camera.sun.w*nl;
        }
        for(int i=0;i<int(camera.options.z+0.5);++i) contribution+=directLight(hit,V,lights[i]);
        contribution+=sampleEmission(hit,V,bounce+1u>=bounceLimit);
        vec3 incoming=throughput*contribution;
        if(bounce>0&&camera.render.z>0.0)
        {
            float luminance=dot(incoming,vec3(0.2126,0.7152,0.0722));
            incoming*=min(1.0,camera.render.z/max(luminance,0.00001));
        }
        radiance+=incoming;
        if(bounce+1u>=bounceLimit) break;
        float probability=camera.render.y>0.5?mix(0.25,0.9,hit.metallic):1.0;
        vec3 next;
        if(randomFloat()<probability) next=reflect(-V,sampleVisibleGGX(N,V,hit.roughness));
        else
        {
            float u=randomFloat(),phi=2.0*PI*randomFloat();
            next=normalize(basis(N)*vec3(sqrt(u)*cos(phi),sqrt(u)*sin(phi),sqrt(1.0-u)));
        }
        float cosine=max(dot(N,next),0.0);
        if(cosine<=0.0||dot(hit.geometric,next)<=0.0) break;
        previousPdf=bsdfPdf(N,V,next,hit.metallic,hit.roughness);
        vec3 value=surfaceBrdf(hit,V,next);
        if(camera.render.y<0.5)
        {
            vec3 F=fresnel(max(dot(V,normalize(V+next)),0.0),mix(vec3(0.04),hit.base,hit.metallic));
            value=max(vec3(0),value-(1.0-F)*(1.0-hit.metallic)*hit.base/PI);
        }
        throughput*=value*cosine/max(previousPdf,0.000001);
        if(bounce>1)
        {
            float survive=clamp(max(throughput.r,max(throughput.g,throughput.b)),0.1,0.95);
            if(randomFloat()>survive) break;
            throughput/=survive;
        }
        origin=hit.point+hit.geometric*0.005;direction=next;
    }
    return clamp(radiance,vec3(0),vec3(100));
}
// One diffuse sample and, for smooth materials, one reflection sample.
// Direct lighting and primary visibility stay in the full-resolution raster pass.
vec3 hybridLighting(vec3 origin, vec3 direction, out vec4 firstSurface)
{
    HitSurface hit;
    firstSurface = vec4(0, 0, 0, -1);
    if (!surfaceAt(origin, direction, hit)) return vec3(0);
    if (materials[hit.materialIndex].settings.x < 0.5) return vec3(0);
    firstSurface = vec4(hit.normal, hit.distance);
    vec3 N = hit.normal, V = -direction;
    vec3 F = fresnel(max(dot(N, V), 0.0), mix(vec3(0.04), hit.base, hit.metallic));
    vec3 lighting = vec3(0);
    vec4 ignored;
    vec3 start = hit.point + hit.geometric * 0.005;
    if (hit.metallic < 0.99 && camera.render.y>0.5)
    {
        float u = randomFloat(), angle = randomFloat() * 2.0 * PI;
        vec3 diffuseRay = basis(N) * vec3(sqrt(u) * cos(angle), sqrt(u) * sin(angle), sqrt(1.0 - u));
        vec3 incoming = path(start, normalize(diffuseRay), ignored, 1u);
        lighting += (1.0 - F) * (1.0 - hit.metallic) * hit.base * incoming;
    }
    // Rough surfaces use diffuse GI instead of spending rays on a broad reflection.
    if (hit.roughness < 0.65)
    {
        float u = randomFloat(), v = randomFloat();
        float a = hit.roughness * hit.roughness;
        float cosine = sqrt((1.0 - v) / (1.0 + (a * a - 1.0) * v));
        float sine = sqrt(max(0.0, 1.0 - cosine * cosine));
        vec3 H = normalize(basis(N) * vec3(sine * cos(2.0 * PI * u), sine * sin(2.0 * PI * u), cosine));
        vec3 reflected = reflect(direction, H);
        if (dot(reflected, N) > 0.0 && dot(reflected, hit.geometric) > 0.0)
            lighting += F * path(start, reflected, ignored, 1u);
    }
    return clamp(lighting, vec3(0), vec3(16));
}
void main()
{
    uvec2 pixel=gl_GlobalInvocationID.xy;
    if(pixel.x>=parameters.width||pixel.y>=parameters.height) return;
    uint index=pixel.y*parameters.width+pixel.x;
    bool hybrid=camera.options.y>0.5;
    vec3 sum=vec3(0);float luminanceSum=0,luminanceSquared=0;
    if(parameters.start==0)
    {
        vec2 coord=(vec2(pixel)+0.5)/vec2(parameters.width,parameters.height);
        vec4 target=camera.inverseVP*vec4(coord.x*2.0-1.0,1.0-coord.y*2.0,1,1);
        HitSurface primary;
        bool found=surfaceAt(camera.eye.xyz,normalize(target.xyz/target.w-camera.eye.xyz),primary);
        pixels[index].normalDepth=found?vec4(primary.normal,primary.distance):vec4(0,0,0,hybrid?-1.0:0.0);
        pixels[index].albedoRoughness=found?vec4(primary.base,primary.roughness):vec4(0,0,0,1);
        pixels[index].moments=vec4(0,0,found?float(primary.materialIndex+1):0.0,0);
    }
    for(uint sampleIndex=0;sampleIndex<parameters.samples;++sampleIndex)
    {
        uint sampleNumber=parameters.start+sampleIndex+parameters.pad0;
        state=(index+1u)*9781u+(sampleNumber+1u)*6271u;
        // A rotated R2 sequence distributes primary samples across the pixel.
        uint sampleState=state;state=(index+1u)*9781u;
        vec2 rotation=vec2(randomFloat(),randomFloat());state=sampleState;
        vec2 jitter=hybrid?vec2(0.5):fract(vec2(0.754877666,0.569840291)*float(sampleNumber+1u)+rotation);
        vec2 coord=(vec2(pixel)+jitter)/vec2(parameters.width,parameters.height);
        vec4 target=camera.inverseVP*vec4(coord.x*2.0-1.0,1.0-coord.y*2.0,1,1);
        vec3 direction=normalize(target.xyz/target.w-camera.eye.xyz);vec4 ignored;
        vec3 color=hybrid?hybridLighting(camera.eye.xyz,direction,ignored):path(camera.eye.xyz,direction,ignored,parameters.bounces);
        sum+=color;
        float luminance=dot(color,vec3(0.2126,0.7152,0.0722));
        luminanceSum+=luminance;luminanceSquared+=luminance*luminance;
    }
    pixels[index].sum+=vec4(sum,float(parameters.samples));
    pixels[index].moments.xy+=vec2(luminanceSum,luminanceSquared);
}
